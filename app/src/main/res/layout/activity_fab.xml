<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_background"
    tools:context=".ui_basics.FabActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/blue_0D1B2A"
        android:padding="@dimen/spacing_8"
        app:title="FAB"
        app:titleTextColor="@color/blue_7EC8E3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16"
            android:paddingBottom="@dimen/spacing_80">

            <!-- Section: Normal FAB -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FloatingActionButton"
                android:textColor="@color/blue_7EC8E3"
                android:textSize="@dimen/text_size_12"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="@dimen/spacing_10" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_16"
                app:cardBackgroundColor="@color/blue_0D1B2A"
                app:cardCornerRadius="@dimen/spacing_8"
                app:strokeColor="@color/blue_1B3A5C"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_14">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Primary action button"
                        android:textColor="@color/white_FFFFFF"
                        android:textSize="@dimen/text_size_14"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Screen ka most important action FAB se karo — Add, Compose, Create."
                        android:textColor="@color/blue_7EC8E3"
                        android:textSize="@dimen/text_size_12"
                        android:layout_marginTop="@dimen/spacing_4" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section: Extended FAB -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ExtendedFloatingActionButton"
                android:textColor="@color/blue_7EC8E3"
                android:textSize="@dimen/text_size_12"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="@dimen/spacing_10" />

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/extendedFab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_16"
                android:text="New Note"
                android:textColor="@color/black_080D14"
                app:icon="@android:drawable/ic_input_add"
                app:iconTint="@color/black_080D14"
                app:backgroundTint="@color/blue_0099CC" />

            <!-- Section: FAB click count -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FAB Click Demo"
                android:textColor="@color/blue_7EC8E3"
                android:textSize="@dimen/text_size_12"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="@dimen/spacing_10" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_16"
                app:cardBackgroundColor="@color/blue_0D1B2A"
                app:cardCornerRadius="@dimen/spacing_8"
                app:strokeColor="@color/blue_0099CC"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_14"
                    android:gravity="center">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvClickCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/blue_00C6FF"
                        android:textSize="@dimen/text_size_48"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FAB pe click karo (bottom-right)"
                        android:textColor="@color/blue_7EC8E3"
                        android:textSize="@dimen/text_size_12"
                        android:layout_marginTop="@dimen/spacing_4" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Key attributes note -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/blue_0D1B2A"
                app:cardCornerRadius="@dimen/spacing_8"
                app:strokeColor="@color/blue_1B3A5C"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_14">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Key Attributes"
                        android:textColor="@color/blue_00C6FF"
                        android:textSize="@dimen/text_size_12"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="app:backgroundTint → FAB color\napp:tint → icon color\napp:fabSize → mini / normal / auto\napp:icon → icon drawable\nandroid:text → ExtendedFAB label"
                        android:textColor="@color/blue_7EC8E3"
                        android:textSize="@dimen/text_size_12"
                        android:layout_marginTop="@dimen/spacing_6"
                        android:lineSpacingExtra="3dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FAB — bottom-right pe constrained -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_16"
        android:layout_marginBottom="@dimen/spacing_16"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/blue_0099CC"
        app:tint="@color/black_080D14"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
