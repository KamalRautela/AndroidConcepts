<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_background"
    tools:context=".activity_fragment_lifecycle.explicit_intent.ExplicitIntentSenderActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/blue_0D1B2A"
        android:padding="@dimen/spacing_8"
        app:title="Explicit Intent — Sender"
        app:titleTextColor="@color/blue_7EC8E3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16">

            <!-- Input Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_16"
                app:cardBackgroundColor="@color/blue_0D1B2A"
                app:cardCornerRadius="@dimen/spacing_12"
                app:strokeColor="@color/blue_1B3A5C"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data Bhejo"
                        android:textColor="@color/blue_7EC8E3"
                        android:textSize="@dimen/text_size_12"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/spacing_14" />

                    <!-- Name -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STRING — Naam"
                        android:textColor="@color/blue_0099CC"
                        android:textSize="@dimen/text_size_10"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="@dimen/spacing_6" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. Kamal Rautela"
                        android:textColor="@color/white_FFFFFF"
                        android:textColorHint="@color/blue_1B3A5C"
                        android:background="@drawable/chip_outline"
                        android:padding="@dimen/spacing_12"
                        android:textSize="@dimen/text_size_14"
                        android:inputType="textPersonName"
                        android:layout_marginBottom="@dimen/spacing_14" />

                    <!-- Age -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INT — Age"
                        android:textColor="@color/blue_0099CC"
                        android:textSize="@dimen/text_size_10"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="@dimen/spacing_6" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etAge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. 24"
                        android:textColor="@color/white_FFFFFF"
                        android:textColorHint="@color/blue_1B3A5C"
                        android:background="@drawable/chip_outline"
                        android:padding="@dimen/spacing_12"
                        android:textSize="@dimen/text_size_14"
                        android:inputType="number"
                        android:layout_marginBottom="@dimen/spacing_14" />

                    <!-- Float -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FLOAT — Score"
                        android:textColor="@color/blue_0099CC"
                        android:textSize="@dimen/text_size_10"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="@dimen/spacing_6" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etScore"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. 9.5"
                        android:textColor="@color/white_FFFFFF"
                        android:textColorHint="@color/blue_1B3A5C"
                        android:background="@drawable/chip_outline"
                        android:padding="@dimen/spacing_12"
                        android:textSize="@dimen/text_size_14"
                        android:inputType="numberDecimal"
                        android:layout_marginBottom="@dimen/spacing_14" />

                    <!-- Double -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DOUBLE — Price"
                        android:textColor="@color/blue_0099CC"
                        android:textSize="@dimen/text_size_10"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="@dimen/spacing_6" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. 299.99"
                        android:textColor="@color/white_FFFFFF"
                        android:textColorHint="@color/blue_1B3A5C"
                        android:background="@drawable/chip_outline"
                        android:padding="@dimen/spacing_12"
                        android:textSize="@dimen/text_size_14"
                        android:inputType="numberDecimal"
                        android:layout_marginBottom="@dimen/spacing_14" />

                    <!-- Long -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LONG — User ID"
                        android:textColor="@color/blue_0099CC"
                        android:textSize="@dimen/text_size_10"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="@dimen/spacing_6" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etUserId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. 1234567890"
                        android:textColor="@color/white_FFFFFF"
                        android:textColorHint="@color/blue_1B3A5C"
                        android:background="@drawable/chip_outline"
                        android:padding="@dimen/spacing_12"
                        android:textSize="@dimen/text_size_14"
                        android:inputType="number"
                        android:layout_marginBottom="@dimen/spacing_14" />

                    <!-- Boolean -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/spacing_16">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BOOLEAN — isPremium"
                                android:textColor="@color/blue_0099CC"
                                android:textSize="@dimen/text_size_10"
                                android:fontFamily="monospace"
                                android:layout_marginBottom="@dimen/spacing_4" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvIsPremium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="false"
                                android:textColor="@color/blue_7EC8E3"
                                android:textSize="@dimen/text_size_14"
                                android:fontFamily="monospace" />

                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchIsPremium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnSend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="▶  Start Activity B"
                        android:textColor="@color/black_080D14"
                        android:backgroundTint="@color/blue_0099CC"
                        android:stateListAnimator="@null" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Note Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/blue_0D1B2A"
                app:cardCornerRadius="@dimen/spacing_12"
                app:strokeColor="@color/blue_0099CC"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_14">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Code"
                        android:textColor="@color/blue_00C6FF"
                        android:textSize="@dimen/text_size_12"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/spacing_6" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text='val intent = Intent(this, ActivityB::class.java)\nintent.putExtra("name", name)\nintent.putExtra("age", age)\nstartActivity(intent)'
                        android:textColor="@color/blue_7EC8E3"
                        android:textSize="@dimen/text_size_12"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="3dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
