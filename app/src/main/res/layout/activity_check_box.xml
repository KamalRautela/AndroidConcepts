<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_background"
    tools:context=".ui_basics.CheckBoxActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/blue_0D1B2A"
        android:padding="@dimen/spacing_8"
        app:title="@string/checkbox"
        app:titleTextColor="@color/blue_7EC8E3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16">

            <!-- BASIC CHECKBOX -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Basic CheckBox"
                tools:ignore="HardcodedText"
                android:textColor="@color/blue_7EC8E3"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/spacing_8" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkBoxBasic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I agree to the terms"
                tools:ignore="HardcodedText"
                android:textColor="@color/white_FFFFFF"
                android:layout_marginBottom="@dimen/spacing_8" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvBasicState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="State: Unchecked"
                tools:ignore="HardcodedText"
                android:textColor="@color/blue_7EC8E3"
                android:layout_marginBottom="@dimen/spacing_16" />

            <!-- MULTIPLE CHECKBOXES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_8">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Select Topics"
                    tools:ignore="HardcodedText"
                    android:textColor="@color/blue_7EC8E3"
                    android:textSize="12sp"
                    android:letterSpacing="0.1" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 / 4"
                    tools:ignore="HardcodedText"
                    android:textColor="@color/blue_00C6FF"
                    android:textSize="12sp" />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkBoxKotlin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kotlin"
                tools:ignore="HardcodedText"
                android:textColor="@color/white_FFFFFF" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkBoxCompose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jetpack Compose"
                tools:ignore="HardcodedText"
                android:textColor="@color/white_FFFFFF" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkBoxMvvm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MVVM Architecture"
                tools:ignore="HardcodedText"
                android:textColor="@color/white_FFFFFF" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkBoxApi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="REST APIs"
                tools:ignore="HardcodedText"
                android:textColor="@color/white_FFFFFF"
                android:layout_marginBottom="@dimen/spacing_16" />

            <!-- SELECT ALL / DESELECT ALL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_16">

                <Button
                    android:id="@+id/btnSelectAll"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:ignore="HardcodedText"
                    android:text="Select All" />

                <Button
                    android:id="@+id/btnDeselectAll"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_8"
                    tools:ignore="HardcodedText"
                    android:text="Deselect All" />

            </LinearLayout>

            <!-- SUBMIT -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_8"
                tools:ignore="HardcodedText"
                android:text="Submit" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_12"
                android:background="@color/blue_0D1B2A"
                android:textColor="@color/blue_7EC8E3"
                android:visibility="gone"
                tools:ignore="HardcodedText"
                android:text="" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
