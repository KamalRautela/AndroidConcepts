<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_background"
    tools:context=".json_parsing.retrofit.get_api.RetrofitGetActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/blue_0D1B2A"
        android:padding="@dimen/spacing_8"
        app:title="GET"
        app:titleTextColor="@color/blue_7EC8E3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16">

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="@dimen/spacing_12">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnGetById"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Get Post by ID"
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/black_080D14"
                    android:backgroundTint="@color/blue_0099CC"
                    android:stateListAnimator="@null"
                    android:layout_marginEnd="@dimen/spacing_8" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnGetByUser"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Get Posts by User"
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/black_080D14"
                    android:backgroundTint="@color/blue_1B3A5C" />

            </LinearLayout>

            <!-- Status -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Idle — button dabao"
                android:textColor="@color/orange_FF9800"
                android:textSize="@dimen/text_size_12"
                android:gravity="center"
                android:layout_marginBottom="@dimen/spacing_16" />

            <!-- Single Post Result Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_16"
                app:cardBackgroundColor="@color/blue_0D1B2A"
                app:cardCornerRadius="@dimen/spacing_12"
                app:strokeColor="@color/blue_1B3A5C"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@GET posts/{id} — Single Post"
                        android:textColor="@color/blue_7EC8E3"
                        android:textSize="@dimen/text_size_10"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="@dimen/spacing_12" />

                    <!-- userId row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/spacing_10">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="post.userId"
                            android:textColor="@color/blue_7EC8E3"
                            android:fontFamily="monospace"
                            android:textSize="@dimen/text_size_14" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvUserId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="@color/orange_FF9800"
                            android:textSize="@dimen/text_size_18"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            tools:text="1" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/blue_1B3A5C"
                        android:layout_marginBottom="@dimen/spacing_10" />

                    <!-- title row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="post.title"
                            android:textColor="@color/blue_7EC8E3"
                            android:fontFamily="monospace"
                            android:textSize="@dimen/text_size_14"
                            android:layout_marginBottom="@dimen/spacing_4" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="@color/blue_00C6FF"
                            android:textSize="@dimen/text_size_14"
                            tools:text="sunt aut facere repellat provident..." />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- List Result Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_16"
                app:cardBackgroundColor="@color/blue_0D1B2A"
                app:cardCornerRadius="@dimen/spacing_12"
                app:strokeColor="@color/blue_1B3A5C"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@GET posts?userId= — List&lt;Post&gt;"
                        android:textColor="@color/blue_7EC8E3"
                        android:textSize="@dimen/text_size_10"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="@dimen/spacing_12" />

                    <!-- Rows added dynamically via layoutInflater.inflate(R.layout.item_post_row, ...) -->
                    <LinearLayout
                        android:id="@+id/containerResults"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- How to Test Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/blue_0D1B2A"
                app:cardCornerRadius="@dimen/spacing_12"
                app:strokeColor="@color/blue_0099CC"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_14">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="How to Test"
                        android:textColor="@color/blue_00C6FF"
                        android:textSize="@dimen/text_size_12"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/spacing_6" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Internet chalu hona chahiye (emulator/device pe)\n2. 'Get Post by ID' — ek single post (id=1) fetch karke card mein dikhayega\n3. 'Get Posts by User' — userId=1 ke saare posts list mein dikhayega\n4. Fail ho (no internet) toh status mein error message dikhega, crash nahi hoga"
                        android:textColor="@color/blue_7EC8E3"
                        android:textSize="@dimen/text_size_12"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
