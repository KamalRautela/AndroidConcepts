<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui_basics.TextViewActivity">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/blue_0D1B2A"
        android:padding="@dimen/spacing_8"
        app:title="@string/text_view"
        app:titleTextColor="@color/blue_7EC8E3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Preview Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/previewCard"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_margin="@dimen/spacing_16"
        app:cardBackgroundColor="@color/blue_0D1B2A"
        app:cardCornerRadius="@dimen/spacing_12"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/previewTextView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="@dimen/spacing_16"
            android:text="Android TextView — tap controls below!"
            tools:ignore="HardcodedText"
            android:textColor="@color/white_FFFFFF"
            android:textSize="16sp" />

    </androidx.cardview.widget.CardView>

    <!-- Controls ScrollView -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/previewCard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16"
            android:layout_marginBottom="16dp">

            <!-- TEXT STYLE SECTION -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Text Style"
                tools:ignore="HardcodedText"
                android:textColor="@color/blue_7EC8E3"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/spacing_8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_16">

                <Button
                    android:id="@+id/btnNormal"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:ignore="HardcodedText"
                    android:text="Normal" />

                <Button
                    android:id="@+id/btnBold"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_marginHorizontal="@dimen/spacing_6"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:ignore="HardcodedText"
                    android:text="Bold" />

                <Button
                    android:id="@+id/btnItalic"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:ignore="HardcodedText"
                    android:text="Italic" />

            </LinearLayout>

            <!-- TEXT SIZE SECTION -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Text Size"
                tools:ignore="HardcodedText"
                android:textColor="@color/blue_7EC8E3"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/spacing_8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_16">

                <Button
                    android:id="@+id/btnSmall"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:ignore="HardcodedText"
                    android:text="Small" />

                <Button
                    android:id="@+id/btnMedium"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_marginHorizontal="@dimen/spacing_6"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:ignore="HardcodedText"
                    android:text="Medium" />

                <Button
                    android:id="@+id/btnLarge"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:ignore="HardcodedText"
                    android:text="Large" />

            </LinearLayout>

            <!-- ALIGNMENT SECTION -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alignment"
                tools:ignore="HardcodedText"
                android:textColor="@color/blue_7EC8E3"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/spacing_8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_16">

                <Button
                    android:id="@+id/btnStart"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:ignore="HardcodedText"
                    android:text="Start" />

                <Button
                    android:id="@+id/btnCenter"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_marginHorizontal="@dimen/spacing_6"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:ignore="HardcodedText"
                    android:text="Center" />

                <Button
                    android:id="@+id/btnEnd"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:ignore="HardcodedText"
                    android:text="End" />

            </LinearLayout>

            <!-- MAX LINES -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAX LINES"
                tools:ignore="HardcodedText"
                android:textColor="@color/blue_7EC8E3"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/spacing_8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_16">

                <Button
                    android:id="@+id/btnToggleMaxLines"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:ignore="HardcodedText"
                    android:text="Toggle Max Lines Off" />

            </LinearLayout>

            <!-- SPANNABLE SECTION -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SpannableString"
                tools:ignore="HardcodedText"
                android:textColor="@color/blue_7EC8E3"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/spacing_8" />

            <Button
                android:id="@+id/btnSpannable"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_8"
                tools:ignore="HardcodedText"
                android:text="Apply Spannable" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/spannableTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_16"
                android:padding="@dimen/spacing_12"
                android:background="@color/blue_0D1B2A"
                tools:ignore="HardcodedText"
                android:text="Tap button to see SpannableString in action"
                android:textColor="@color/white_FFFFFF" />

            <!-- AUTOLINK SECTION -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AutoLink"
                tools:ignore="HardcodedText"
                android:textColor="@color/blue_7EC8E3"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/spacing_8" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/autoLinkTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_12"
                android:background="@color/blue_0D1B2A"
                android:autoLink="web|email"
                android:textColor="@color/white_FFFFFF"
                android:layout_marginBottom="@dimen/spacing_16"
                tools:ignore="HardcodedText"
                android:text="Visit www.android.com or email dev@example.com" />


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>