<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_background"
    tools:context=".broadcast_receiver.dynamic_broadcast_receiver.DynamicBroadcastReceiverActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/blue_0D1B2A"
        android:padding="@dimen/spacing_8"
        app:title="Dynamic Broadcast Receiver"
        app:titleTextColor="@color/blue_7EC8E3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_16"
        app:cardBackgroundColor="@color/blue_0D1B2A"
        app:cardCornerRadius="@dimen/spacing_12"
        app:strokeColor="@color/blue_1B3A5C"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM BROADCAST"
                tools:ignore="HardcodedText"
                android:textColor="@color/blue_7EC8E3"
                android:textSize="@dimen/text_size_10"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/spacing_12" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Listening for: ACTION_AIRPLANE_MODE_CHANGED"
                tools:ignore="HardcodedText"
                android:textColor="@color/blue_00C6FF"
                android:textStyle="bold"
                android:textSize="@dimen/text_size_12" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_16"
        android:text="Yeh receiver sirf tab sunta hai jab yeh screen khuli hai (onStart se onStop tak). Settings se Airplane Mode ON/OFF karo jabki yeh screen khuli hai — Logcat mein 'state' extra ke saath log aayega."
        tools:ignore="HardcodedText"
        android:textColor="@color/blue_7EC8E3"
        android:textSize="@dimen/text_size_12"
        android:lineSpacingExtra="4dp"
        app:layout_constraintTop_toBottomOf="@id/cardControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
