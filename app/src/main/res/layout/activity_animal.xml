<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_background"
    tools:context=".hilt.room.AnimalActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/blue_0D1B2A"
        android:padding="@dimen/spacing_8"
        app:title="Animal List (Room + Hilt)"
        app:titleTextColor="@color/blue_7EC8E3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Input Rows -->
    <LinearLayout
        android:id="@+id/inputRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etAnimalName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="e.g. Tiger"
                android:textColor="@color/white_FFFFFF"
                android:textColorHint="@color/blue_1B3A5C"
                android:background="@drawable/chip_outline"
                android:padding="@dimen/spacing_12"
                android:textSize="@dimen/text_size_14"
                android:layout_marginEnd="@dimen/spacing_12" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etAnimalSpecies"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="e.g. Panthera tigris"
                android:textColor="@color/white_FFFFFF"
                android:textColorHint="@color/blue_1B3A5C"
                android:background="@drawable/chip_outline"
                android:padding="@dimen/spacing_12"
                android:textSize="@dimen/text_size_14" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAdd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="+ Add Animal"
            android:textColor="@color/black_080D14"
            android:backgroundTint="@color/blue_0099CC"
            android:stateListAnimator="@null" />

    </LinearLayout>

    <!-- Empty State -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Koi animal nahi hai — upar se add karo"
        android:textColor="@color/blue_7EC8E3"
        android:textSize="@dimen/text_size_14"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/rvAnimals"
        app:layout_constraintBottom_toBottomOf="@id/rvAnimals"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Animal List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAnimals"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/spacing_16"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/inputRow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_animal_row"
        tools:itemCount="3" />

</androidx.constraintlayout.widget.ConstraintLayout>
