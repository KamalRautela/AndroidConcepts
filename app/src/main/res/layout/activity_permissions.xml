<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_background"
    tools:context=".activity_fragment_lifecycle.permission.PermissionDemoActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/blue_0D1B2A"
        android:padding="@dimen/spacing_8"
        app:title="Permissions"
        app:titleTextColor="@color/blue_7EC8E3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16">

            <!-- Type Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_12"
                app:cardBackgroundColor="@color/blue_0D1B2A"
                app:cardCornerRadius="@dimen/spacing_12"
                app:strokeColor="@color/blue_1B3A5C"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_14">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Permission Types"
                        android:textColor="@color/blue_7EC8E3"
                        android:textSize="@dimen/text_size_12"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/spacing_8" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INTERNET  →  Normal (auto-grant, no dialog)"
                        android:textColor="#4CAF50"
                        android:textSize="@dimen/text_size_10"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="@dimen/spacing_4" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CAMERA / LOCATION / CONTACTS  →  Dangerous (runtime dialog)"
                        android:textColor="#EF5350"
                        android:textSize="@dimen/text_size_10"
                        android:fontFamily="monospace" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Request Buttons Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_12"
                app:cardBackgroundColor="@color/blue_0D1B2A"
                app:cardCornerRadius="@dimen/spacing_12"
                app:strokeColor="@color/blue_1B3A5C"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_14">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Request Dangerous Permission"
                        android:textColor="@color/blue_7EC8E3"
                        android:textSize="@dimen/text_size_12"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/spacing_10" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnCamera"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_8"
                        android:text="Request CAMERA"
                        android:textColor="@color/black_080D14"
                        android:fontFamily="monospace"
                        android:backgroundTint="@color/blue_0099CC"
                        android:stateListAnimator="@null" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_8"
                        android:text="Request LOCATION"
                        android:textColor="@color/white_FFFFFF"
                        android:fontFamily="monospace"
                        android:backgroundTint="#2E7D32"
                        android:stateListAnimator="@null" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnContacts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Request CONTACTS"
                        android:textColor="@color/white_FFFFFF"
                        android:fontFamily="monospace"
                        android:backgroundTint="#6A1B9A"
                        android:stateListAnimator="@null" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_12"
                app:cardBackgroundColor="@color/blue_0D1B2A"
                app:cardCornerRadius="@dimen/spacing_12"
                app:strokeColor="@color/blue_1B3A5C"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_14">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status"
                        android:textColor="@color/blue_7EC8E3"
                        android:textSize="@dimen/text_size_12"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/spacing_8" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvPermissionName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/blue_00C6FF"
                        android:textSize="@dimen/text_size_14"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/spacing_4" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Koi permission request nahi ki abhi"
                        android:textColor="@color/blue_7EC8E3"
                        android:textSize="@dimen/text_size_12"
                        android:fontFamily="monospace" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Rationale Card (hidden by default) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRationale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_12"
                android:visibility="gone"
                app:cardBackgroundColor="#1A0E00"
                app:cardCornerRadius="@dimen/spacing_12"
                app:strokeColor="#FFB74D"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_14">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rationale — Kyun chahiye?"
                        android:textColor="#FFB74D"
                        android:textSize="@dimen/text_size_12"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/spacing_6" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvRationale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFCC80"
                        android:textSize="@dimen/text_size_12"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="@dimen/spacing_10" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnRequestAgain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Request Again"
                        android:textColor="@color/black_080D14"
                        android:fontFamily="monospace"
                        android:backgroundTint="#FFB74D"
                        android:stateListAnimator="@null" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Settings Card (hidden by default) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="#1A0500"
                app:cardCornerRadius="@dimen/spacing_12"
                app:strokeColor="#EF5350"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_14">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Permanently Denied"
                        android:textColor="#EF5350"
                        android:textSize="@dimen/text_size_12"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/spacing_6" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dialog dobara nahi aayega. App Settings mein jaake manually enable karo."
                        android:textColor="#EF9A9A"
                        android:textSize="@dimen/text_size_12"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="@dimen/spacing_10" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnOpenSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Open App Settings"
                        android:textColor="@color/white_FFFFFF"
                        android:fontFamily="monospace"
                        android:backgroundTint="#EF5350"
                        android:stateListAnimator="@null" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
