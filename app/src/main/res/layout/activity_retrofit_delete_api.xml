<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_background"
    tools:context=".json_parsing.retrofit.delete_api.RetrofitDeleteApiActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/blue_0D1B2A"
        android:padding="@dimen/spacing_8"
        app:title="DELETE"
        app:titleTextColor="@color/blue_7EC8E3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16">

            <!-- Input Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_16"
                app:cardBackgroundColor="@color/blue_0D1B2A"
                app:cardCornerRadius="@dimen/spacing_12"
                app:strokeColor="@color/blue_1B3A5C"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="POST ID (delete karne ke liye)"
                        android:textColor="@color/blue_7EC8E3"
                        android:textSize="@dimen/text_size_10"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="@dimen/spacing_10" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. 3"
                        android:inputType="number"
                        android:textColor="@color/white_FFFFFF"
                        android:textColorHint="@color/blue_1B3A5C"
                        android:background="@drawable/chip_outline"
                        android:padding="@dimen/spacing_12"
                        android:textSize="@dimen/text_size_14"
                        android:layout_marginBottom="@dimen/spacing_16" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnDelete"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🗑 Delete Post"
                        android:textColor="@color/white_FFFFFF"
                        android:backgroundTint="@color/blue_1B3A5C"
                        android:stateListAnimator="@null" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Status / Confirmation Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_16"
                app:cardBackgroundColor="@color/blue_0D1B2A"
                app:cardCornerRadius="@dimen/spacing_12"
                app:strokeColor="@color/blue_1B3A5C"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16"
                    android:gravity="center">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Idle — ID daalo aur Delete Post dabao"
                        android:textColor="@color/orange_FF9800"
                        android:textSize="@dimen/text_size_14"
                        android:gravity="center" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- How to Test Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/blue_0D1B2A"
                app:cardCornerRadius="@dimen/spacing_12"
                app:strokeColor="@color/blue_0099CC"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_14">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="How to Test"
                        android:textColor="@color/blue_00C6FF"
                        android:textSize="@dimen/text_size_12"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/spacing_6" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Post ID daalo (jaise 3)\n2. Delete Post dabao — @Path se id jaayega, koi @Body nahi\n3. JSONPlaceholder fake success dega (asal delete nahi hota)\n4. Status card mein confirmation ya error dikhega"
                        android:textColor="@color/blue_7EC8E3"
                        android:textSize="@dimen/text_size_12"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
